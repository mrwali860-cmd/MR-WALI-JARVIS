# Local development configuration only. Never commit real credentials.
# Copy to .env locally and fill only the credentials for integrations you actually use.

# AI provider (optional for deterministic/test paths; required for live AI calls)
OPENAI_API_KEY=
JARVIS_OPENAI_MODEL=

# Prospect discovery (required for live Apify research)
APIFY_TOKEN=
AI_DEMAND_MAX_RESULTS=20
AI_DEMAND_SEARCH_ACTOR=searchapi~google-search-scraper

# Approved email outreach only. Keep disabled until sender/domain and approval flow are verified.
RESEND_API_KEY=
OUTREACH_FROM_EMAIL=
EMAIL_OUTREACH_ENABLED=false
OUTREACH_MAX_PER_RUN=10

# Optional discovery/runtime tuning
APIFY_POLL_MS=3000
APIFY_TIMEOUT_MS=600000
