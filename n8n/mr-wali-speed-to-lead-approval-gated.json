{
  "name": "MR WALI JARVIS - Speed-to-Lead (Draft Logging Only)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "jarvis-speed-to-lead",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "lead-webhook",
      "name": "Receive Lead Draft",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        240
      ],
      "webhookId": "jarvis-speed-to-lead"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "name",
              "name": "name",
              "value": "={{ $json.body.lead.name }}",
              "type": "string"
            },
            {
              "id": "email",
              "name": "email",
              "value": "={{ $json.body.lead.email }}",
              "type": "string"
            },
            {
              "id": "phone",
              "name": "phone",
              "value": "={{ $json.body.lead.phone }}",
              "type": "string"
            },
            {
              "id": "industry",
              "name": "industry",
              "value": "={{ $json.body.lead.industry }}",
              "type": "string"
            },
            {
              "id": "original_message",
              "name": "original_message",
              "value": "={{ $json.body.lead.original_message }}",
              "type": "string"
            },
            {
              "id": "lead_score",
              "name": "lead_score",
              "value": "={{ $json.body.analysis.lead_score }}",
              "type": "string"
            },
            {
              "id": "intent",
              "name": "intent",
              "value": "={{ $json.body.analysis.intent }}",
              "type": "string"
            },
            {
              "id": "reply_draft",
              "name": "reply_draft",
              "value": "={{ $json.body.analysis.reply_draft }}",
              "type": "string"
            },
            {
              "id": "approved_for_sending",
              "name": "approved_for_sending",
              "value": "={{ $json.body.approved_for_sending === true }}",
              "type": "boolean"
            },
            {
              "id": "delivery_status",
              "name": "delivery_status",
              "value": "={{ $json.body.delivery_status }}",
              "type": "string"
            },
            {
              "id": "received_at",
              "name": "received_at",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "normalize",
      "name": "Normalize Lead Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        240
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "name": "={{ $json.name }}",
            "email": "={{ $json.email }}",
            "phone": "={{ $json.phone }}",
            "industry": "={{ $json.industry }}",
            "original_message": "={{ $json.original_message }}",
            "lead_score": "={{ $json.lead_score }}",
            "intent": "={{ $json.intent }}",
            "reply_draft": "={{ $json.reply_draft }}",
            "approved_for_sending": "={{ $json.approved_for_sending }}",
            "delivery_status": "={{ $json.delivery_status }}",
            "received_at": "={{ $json.received_at }}"
          },
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "options": {}
      },
      "id": "google-sheets",
      "name": "Append Lead to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        500,
        240
      ],
      "credentials": {
        "googleSheetsOAuth2": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {},
      "id": "approval-gate",
      "name": "Approval Status (No Auto-Send)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        760,
        240
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: true, logged: true, message_sent: false, status: 'DRAFT_ONLY', note: 'Lead logged. This workflow never sends email; configure a separate authenticated human-approval workflow before delivery.' } }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "respond-draft",
      "name": "Respond - Draft Saved Only",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1020,
        340
      ]
    }
  ],
  "connections": {
    "Receive Lead Draft": {
      "main": [
