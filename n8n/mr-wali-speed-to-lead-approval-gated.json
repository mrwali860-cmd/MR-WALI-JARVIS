            "index": 0
          }
        ]
      ]
    },
    "Append Lead to Google Sheets": {
      "main": [
        [
          {
            "node": "Respond - Draft Saved Only",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
